-- Auto-Steal background listener
task.spawn(function()
    while true do
        if autoStealActive then
            local char = LP.Character
            local hasStealItem = false
            if char then
                for _, child in ipairs(char:GetChildren()) do
                    if child:IsA("Tool") then
                        local n = string.lower(child.Name)
                        if n:find("steal") or n:find("cash") or n:find("bag") or n:find("loot") or n:find("brainrot") then
                            hasStealItem = true
                        end
                    end
                end
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid and humanoid.Health > 0 and humanoid.WalkSpeed < 25 then
                    hasStealItem = true
                end
            end
            if hasStealItem then
                if not active then setActive(true) end
            else
                if active then setActive(false) end
            end
        end
        task.wait(0.2)
    end
end)

KeyBtn.MouseButton1Click:Connect(function()
    if isBinding then return end
    isBinding = true
    KeyBtn.Text = "Press key..."
    KeyBtn.TextColor3 = ACCENT_BRIGHT
    playSfx("Keybind")
end)

UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end
    if isBinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            isBinding = false
            toggleKey = input.KeyCode
            KeyBtn.Text = "Key: " .. toggleKey.Name
            KeyBtn.TextColor3 = TEXT_WHITE
            playSfx("Keybind")
        elseif input.UserInputType == Enum.UserInputType.Gamepad1 then
            isBinding = false
            toggleGamepadKey = input.KeyCode
            KeyBtn.Text = "Key: " .. toggleGamepadKey.Name
            KeyBtn.TextColor3 = TEXT_WHITE
            playSfx("Keybind")
        end
        return
    end

    if input.KeyCode == toggleKey or input.KeyCode == toggleGamepadKey then
        playSfx("Toggle")
        setActive(not active)
    end
end)

-- Dragging
local dragging, dragStart, startPos
TitleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Main.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        Main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

