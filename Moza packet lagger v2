local toggleGamepadKey = Enum.KeyCode.ButtonY

-- Border Glow Animation
RunService.RenderStepped:Connect(function(dt)
    local speed = active and 160 or 60
    BorderGrad.Rotation = (BorderGrad.Rotation + speed * dt) % 360
end)

local function setActive(state)
    active = state
    if state then
        Toggle.BackgroundColor3 = ACCENT_BRIGHT
        ToggleGrad.Color = ColorSequence.new(ACCENT_RED, ACCENT_BRIGHT)
        ToggleGrad.Rotation = 0
        ToggleStroke.Color = Color3.fromRGB(255, 255, 255)
        ToggleLabel.Text = "ENABLED"
        ToggleLabel.TextColor3 = BG_BLACK
        if api and api.start then pcall(api.start) end
        playSfx("Start")
    else
        Toggle.BackgroundColor3 = BG_INPUT
        ToggleGrad.Color = ColorSequence.new(BG_INPUT, Color3.fromRGB(15, 30, 20))
        ToggleGrad.Rotation = 135
        ToggleStroke.Color = STROKE_RED
        ToggleLabel.Text = "DISABLED"
        ToggleLabel.TextColor3 = TEXT_WHITE
        if api and api.stop then pcall(api.stop) end
        playSfx("Stop")
    end
end

