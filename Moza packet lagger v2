    Saved   = makeSfx("Saved",    9114313755, 0.40, 1.3),
    Error   = makeSfx("Error",    9114316718, 0.40, 0.6),
}

local function playSfx(name)
    local s = SFX[name]
    if not s then return end
    s:Stop()
    s:Play()
end

